<Window x:Class="LaserCursorApp.Options.OptionsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ctrl="clr-namespace:LaserCursorApp.Controls"
        Title="Laser Cursor Pro — Options"
        Width="820" Height="720"
        MinWidth="720" MinHeight="600"
        ResizeMode="CanResizeWithGrip"
        WindowStartupLocation="CenterScreen"
        Background="#1A1A2A">

    <Window.Resources>
        <!-- Section header -->
        <Style x:Key="SectionHeader" TargetType="TextBlock">
            <Setter Property="Foreground"   Value="#FF3838"/>
            <Setter Property="FontSize"     Value="11"/>
            <Setter Property="FontWeight"   Value="SemiBold"/>
            <Setter Property="Margin"       Value="0,14,0,6"/>
        </Style>
        <!-- Setting row label -->
        <Style x:Key="RowLabel" TargetType="TextBlock">
            <Setter Property="Foreground"         Value="#CCCCDD"/>
            <Setter Property="VerticalAlignment"  Value="Center"/>
            <Setter Property="Width"              Value="140"/>
            <Setter Property="FontSize"           Value="12"/>
        </Style>
        <!-- Value readout -->
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Foreground"        Value="#9999AA"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Width"             Value="44"/>
            <Setter Property="FontFamily"        Value="Consolas"/>
            <Setter Property="FontSize"          Value="11"/>
            <Setter Property="Margin"            Value="6,0,0,0"/>
        </Style>
        <!-- CheckBox -->
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="#CCCCDD"/>
            <Setter Property="FontSize"   Value="12"/>
        </Style>
        <!-- Separator -->
        <Style TargetType="Separator">
            <Setter Property="Background" Value="#2E2E42"/>
            <Setter Property="Margin"     Value="0,4,0,8"/>
        </Style>
        <!-- Group box -->
        <Style TargetType="GroupBox">
            <Setter Property="Foreground"   Value="#AAAACC"/>
            <Setter Property="BorderBrush"  Value="#2E2E44"/>
            <Setter Property="Margin"       Value="0,0,0,10"/>
            <Setter Property="Padding"      Value="8,4,8,8"/>
        </Style>
        <!-- List box -->
        <Style TargetType="ListBox">
            <Setter Property="Background"   Value="#252535"/>
            <Setter Property="BorderBrush"  Value="#3A3A52"/>
            <Setter Property="Foreground"   Value="#DDDDEE"/>
        </Style>
        <Style TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="#DDDDEE"/>
            <Setter Property="Padding"    Value="6,4"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#3A3A5A"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Button -->
        <Style TargetType="Button">
            <Setter Property="Background"   Value="#2E2E44"/>
            <Setter Property="Foreground"   Value="#CCCCDD"/>
            <Setter Property="BorderBrush"  Value="#444466"/>
            <Setter Property="Padding"      Value="10,4"/>
            <Setter Property="FontSize"     Value="12"/>
            <Setter Property="Cursor"       Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#3E3E5E"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Tab style -->
        <Style TargetType="TabItem">
            <Setter Property="Background"  Value="#252535"/>
            <Setter Property="Foreground"  Value="#AAAACC"/>
            <Setter Property="BorderBrush" Value="#2E2E44"/>
            <Setter Property="Padding"     Value="16,6"/>
            <Setter Property="FontSize"    Value="12"/>
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#1E1E2E"/>
                    <Setter Property="Foreground" Value="#FF3838"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="TabControl">
            <Setter Property="Background"  Value="#1E1E2E"/>
            <Setter Property="BorderBrush" Value="#2E2E44"/>
        </Style>
        <!-- TextBox -->
        <Style TargetType="TextBox">
            <Setter Property="Background"   Value="#252535"/>
            <Setter Property="Foreground"   Value="#DDDDEE"/>
            <Setter Property="BorderBrush"  Value="#3A3A52"/>
            <Setter Property="Padding"      Value="4,2"/>
        </Style>
        <!-- Reset button — subtle, highlights red on hover -->
        <Style x:Key="ResetBtn" TargetType="Button">
            <Setter Property="Background"        Value="Transparent"/>
            <Setter Property="Foreground"        Value="#44445A"/>
            <Setter Property="BorderThickness"   Value="0"/>
            <Setter Property="Padding"           Value="3,0"/>
            <Setter Property="FontSize"          Value="14"/>
            <Setter Property="Cursor"            Value="Hand"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Foreground" Value="#FF3838"/>
                </Trigger>
            </Style.Triggers>
        </Style>
        <!-- Editable value box for sliders -->
        <Style x:Key="ValueBox" TargetType="TextBox">
            <Setter Property="Background"        Value="#252535"/>
            <Setter Property="Foreground"        Value="#DDDDEE"/>
            <Setter Property="BorderBrush"       Value="#3A3A52"/>
            <Setter Property="BorderThickness"   Value="1"/>
            <Setter Property="Padding"           Value="2,1"/>
            <Setter Property="FontSize"          Value="12"/>
            <Setter Property="TextAlignment"     Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ── Tabs ── -->
        <TabControl Grid.Row="0" Margin="8,8,8,0">

            <!-- ════════ DOT TAB ════════ -->
            <TabItem Header="Dot">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1E1E2E">
                    <StackPanel Margin="16,8,16,16">

                        <!-- Dot Appearance -->
                        <TextBlock Text="DOT APPEARANCE" Style="{StaticResource SectionHeader}"/>
                        <Separator/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetDotColor" ToolTip="Reset to baseline"/>
                                    <TextBlock Text="Dot Color" Style="{StaticResource SectionHeader}" Margin="0"/>
                                </DockPanel>
                                <ctrl:ColorPickerControl x:Name="DotColorPicker" ColorChanged="DotColor_Changed"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetDotSize" ToolTip="Reset to baseline"/>
                                    <TextBlock Text="Dot Size" Style="{StaticResource SectionHeader}" Margin="0"/>
                                </DockPanel>
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="52"/>
                                    </Grid.ColumnDefinitions>
                                    <Slider x:Name="DotSizeSlider" Minimum="1" Maximum="20" TickFrequency="0.5"
                                            ValueChanged="DotSize_Changed" Grid.Column="0" VerticalAlignment="Center"/>
                                    <TextBox x:Name="DotSizeBox" Style="{StaticResource ValueBox}" Grid.Column="1"
                                             GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                </Grid>
                            </StackPanel>
                        </Grid>

                        <!-- Dot Shape Presets -->
                        <TextBlock Text="DOT SHAPE" Style="{StaticResource SectionHeader}"/>
                        <Separator/>

                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetDotShape" ToolTip="Reset to baseline"/>
                            <TextBlock Text="Shape preset" Style="{StaticResource RowLabel}" Width="140"/>
                            <ComboBox x:Name="DotShapeCombo" SelectionChanged="DotShape_Changed">
                                <ComboBoxItem Content="Circle"/>
                                <ComboBoxItem Content="Star"/>
                                <ComboBoxItem Content="Diamond"/>
                                <ComboBoxItem Content="Crosshair"/>
                            </ComboBox>
                        </DockPanel>

                        <!-- Dot Image -->
                        <TextBlock Text="DOT IMAGE" Style="{StaticResource SectionHeader}"/>
                        <Separator/>

                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetDotImage" ToolTip="Reset to baseline"/>
                            <CheckBox x:Name="DotImageCheck" Content="Use custom image  (PNG, BMP, animated GIF)"
                                      Checked="DotImage_Toggle" Unchecked="DotImage_Toggle"/>
                        </DockPanel>

                        <StackPanel x:Name="DotImagePanel" IsEnabled="False" Margin="0,0,0,10">
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Browse…" Click="DotImage_Browse"
                                        Margin="8,0,0,0" Padding="10,3"/>
                                <Button DockPanel.Dock="Right" Content="Clear" Click="DotImage_Clear"
                                        Padding="10,3"/>
                                <TextBlock x:Name="DotImagePathLabel" Text="No file selected"
                                           Foreground="#888899" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            </DockPanel>
                            <Border x:Name="DotImagePreviewBorder" Visibility="Collapsed"
                                    Background="#252535" BorderBrush="#3A3A52" BorderThickness="1"
                                    Height="80" Width="80" HorizontalAlignment="Left" Margin="0,0,0,6">
                                <Image x:Name="DotImagePreview" Stretch="Uniform" Margin="4"/>
                            </Border>
                            <TextBlock Text="Dot Size scales the image." Foreground="#666680" FontSize="11"/>
                        </StackPanel>

                        <!-- Dot Glow -->
                        <TextBlock Text="DOT GLOW" Style="{StaticResource SectionHeader}"/>
                        <Separator/>

                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetDotGlowEnabled" ToolTip="Reset to baseline"/>
                            <CheckBox x:Name="DotGlowCheck" Content="Enable dot glow"
                                      Checked="DotGlow_Toggle" Unchecked="DotGlow_Toggle"/>
                        </DockPanel>

                        <StackPanel x:Name="DotGlowPanel" IsEnabled="False">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetDotGlowColor" ToolTip="Reset to baseline"/>
                                        <TextBlock Text="Glow Color" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    </DockPanel>
                                    <ctrl:ColorPickerControl x:Name="DotGlowColorPicker" ColorChanged="DotGlowColor_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetDotGlowRadius" ToolTip="Reset to baseline"/>
                                        <TextBlock Text="Glow Radius" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="DotGlowRadiusSlider" Minimum="4" Maximum="50" TickFrequency="1"
                                                ValueChanged="DotGlowRadius_Changed" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="DotGlowRadiusBox" Style="{StaticResource ValueBox}" Grid.Column="1"
                                                 GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>

                            <DockPanel Margin="0,4,0,6">
                                <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetDotGlowBloom" ToolTip="Reset to baseline"/>
                                <TextBlock Text="Bloom style" Style="{StaticResource RowLabel}" Width="140"/>
                                <ComboBox x:Name="DotGlowBloomCombo" SelectionChanged="DotGlowBloom_Changed">
                                    <ComboBoxItem Content="Soft"/>
                                    <ComboBoxItem Content="Hard (sharp edge)"/>
                                    <ComboBoxItem Content="Pulse (synced)"/>
                                </ComboBox>
                            </DockPanel>
                        </StackPanel>

                        <!-- Dot Pulse -->
                        <TextBlock Text="DOT PULSE" Style="{StaticResource SectionHeader}"/>
                        <Separator/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetPulseEnabled" ToolTip="Reset to baseline"/>
                            <CheckBox x:Name="PulseCheck" Content="Enable pulse animation"
                                      Checked="Pulse_Toggle" Unchecked="Pulse_Toggle"/>
                        </DockPanel>
                        <StackPanel x:Name="PulsePanel" IsEnabled="False">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Speed (Hz)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="PulseSpeedSlider" Minimum="0.2" Maximum="8" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="PulseSpeed_Changed"/>
                                <TextBox x:Name="PulseSpeedBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetPulseSpeed" ToolTip="Reset to baseline"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Intensity" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="PulseIntensitySlider" Minimum="0.05" Maximum="1" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="PulseIntensity_Changed"/>
                                <TextBox x:Name="PulseIntensityBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetPulseIntensity" ToolTip="Reset to baseline"/>
                            </Grid>
                        </StackPanel>

                        <!-- Dot Spin -->
                        <TextBlock Text="DOT SPIN" Style="{StaticResource SectionHeader}"/>
                        <Separator/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetSpinEnabled" ToolTip="Reset to baseline"/>
                            <CheckBox x:Name="SpinCheck" Content="Enable spin animation (custom image only)"
                                      Checked="Spin_Toggle" Unchecked="Spin_Toggle"/>
                        </DockPanel>
                        <StackPanel x:Name="SpinPanel" IsEnabled="False">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Speed (°/sec)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="SpinSpeedSlider" Minimum="10" Maximum="720" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="SpinSpeed_Changed"/>
                                <TextBox x:Name="SpinSpeedBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetSpinSpeed" ToolTip="Reset to baseline"/>
                            </Grid>
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Direction" Style="{StaticResource RowLabel}" Width="140"/>
                                <ComboBox x:Name="SpinDirCombo" SelectionChanged="SpinDir_Changed">
                                    <ComboBoxItem Content="Clockwise"/>
                                    <ComboBoxItem Content="Counter-clockwise"/>
                                </ComboBox>
                            </DockPanel>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════ TRAIL TAB ════════ -->
            <TabItem Header="Trail">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1E1E2E">
                    <StackPanel Margin="16,8,16,16">

                        <!-- Trail Color -->
                        <TextBlock Text="TRAIL COLOR" Style="{StaticResource SectionHeader}"/>
                        <Separator/>

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0">
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetTailColor" ToolTip="Reset to baseline"/>
                                    <TextBlock Text="Trail Color" Style="{StaticResource SectionHeader}" Margin="0"/>
                                </DockPanel>
                                <ctrl:ColorPickerControl x:Name="TailColorPicker" ColorChanged="TailColor_Changed"/>
                            </StackPanel>

                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                <DockPanel Margin="0,8,0,10">
                                    <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetTailRainbow" ToolTip="Reset to baseline"/>
                                    <CheckBox x:Name="TailRainbowCheck" Content="Rainbow trail  (ROYGBIV)"
                                              Checked="TailRainbow_Toggle" Unchecked="TailRainbow_Toggle"/>
                                </DockPanel>
                                <DockPanel Margin="0,8,0,10">
                                    <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetTailGradEnabled" ToolTip="Reset to baseline"/>
                                    <CheckBox x:Name="TailGradCheck" Content="Enable gradient"
                                              Checked="TailGrad_Toggle" Unchecked="TailGrad_Toggle"/>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,4">
                                    <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetTailGradColor" ToolTip="Reset to baseline"/>
                                    <TextBlock Text="Gradient End Color" Style="{StaticResource SectionHeader}" Margin="0"/>
                                </DockPanel>
                                <ctrl:ColorPickerControl x:Name="TailGradColorPicker" IsEnabled="False"
                                                         ColorChanged="TailGradColor_Changed"/>
                            </StackPanel>
                        </Grid>

                        <!-- Trail Image -->
                        <TextBlock Text="TRAIL IMAGE" Style="{StaticResource SectionHeader}"/>
                        <Separator/>

                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetTailImage" ToolTip="Reset to baseline"/>
                            <CheckBox x:Name="TailImageCheck" Content="Use custom trail image  (PNG, BMP, GIF)"
                                      Checked="TailImage_Toggle" Unchecked="TailImage_Toggle"/>
                        </DockPanel>

                        <StackPanel x:Name="TailImagePanel" IsEnabled="False" Margin="0,0,0,10">
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Content="Browse&#x2026;" Click="TailImage_Browse"
                                        Margin="8,0,0,0" Padding="10,3"/>
                                <Button DockPanel.Dock="Right" Content="Clear" Click="TailImage_Clear"
                                        Padding="10,3"/>
                                <TextBlock x:Name="TailImagePathLabel" Text="No file selected"
                                           Foreground="#888899" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Margin="0,0,8,0"/>
                            </DockPanel>
                            <Border x:Name="TailImagePreviewBorder" Visibility="Collapsed"
                                    Background="#252535" BorderBrush="#3A3A52" BorderThickness="1"
                                    Height="40" HorizontalAlignment="Stretch" Margin="0,0,0,4">
                                <Image x:Name="TailImagePreview" Stretch="Fill" Margin="4"/>
                            </Border>
                            <TextBlock Text="Image height fills the trail width; image width stretches along the trail length."
                                       Foreground="#666680" FontSize="11" TextWrapping="Wrap"/>
                        </StackPanel>

                        <!-- Trail Shape -->
                        <TextBlock Text="TRAIL SHAPE" Style="{StaticResource SectionHeader}"/>
                        <Separator/>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Length (ms)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                            <Slider x:Name="TailLengthSlider" Minimum="80" Maximum="1200" Grid.Column="1"
                                    VerticalAlignment="Center" ValueChanged="TailLength_Changed"/>
                            <TextBox x:Name="TailLengthBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                     GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                            <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetTailLength" ToolTip="Reset to baseline"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Thickness (px)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                            <Slider x:Name="TailThicknessSlider" Minimum="2" Maximum="30" Grid.Column="1"
                                    VerticalAlignment="Center" ValueChanged="TailThickness_Changed"/>
                            <TextBox x:Name="TailThicknessBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                     GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                            <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetTailThickness" ToolTip="Reset to baseline"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Taper" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                            <Slider x:Name="TailTaperSlider" Minimum="0.2" Maximum="2.5" Grid.Column="1"
                                    VerticalAlignment="Center" ValueChanged="TailTaper_Changed"/>
                            <TextBox x:Name="TailTaperBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                     GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                            <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetTailTaper" ToolTip="Reset to baseline"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Fade style" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                            <ComboBox x:Name="TailFadeStyleCombo" Grid.Column="1" SelectionChanged="TailFadeStyle_Changed">
                                <ComboBoxItem Content="Alpha only"/>
                                <ComboBoxItem Content="Thin-and-fade"/>
                                <ComboBoxItem Content="Glow-dissolve"/>
                            </ComboBox>
                            <Button Content="&#x21BA;" Grid.Column="2" Style="{StaticResource ResetBtn}" Click="ResetTailFadeStyle" ToolTip="Reset to baseline"/>
                        </Grid>

                        <Grid Margin="0,0,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Smoothness" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                            <Slider x:Name="TrailSmoothnessSlider" Minimum="0.25" Maximum="3" Grid.Column="1"
                                    VerticalAlignment="Center" ValueChanged="TrailSmoothness_Changed"/>
                            <TextBox x:Name="TrailSmoothnessBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                     GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                            <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetTrailSmoothness" ToolTip="Reset to baseline"/>
                        </Grid>

                        <!-- Smoothness / Butter Mode -->
                        <Grid Margin="0,4,0,6">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Butter Mode" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                            <CheckBox x:Name="ButterCheck" Content="Ultra-smooth high-framerate tracking"
                                      Grid.Column="1" VerticalAlignment="Center"
                                      Checked="Butter_Toggle" Unchecked="Butter_Toggle"/>
                            <Button Content="&#x21BA;" Grid.Column="2" Style="{StaticResource ResetBtn}" Click="ResetButterMode" ToolTip="Reset to baseline"/>
                        </Grid>

                        <!-- Trail Glow -->
                        <TextBlock Text="TRAIL GLOW" Style="{StaticResource SectionHeader}"/>
                        <Separator/>

                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetTailGlowEnabled" ToolTip="Reset to baseline"/>
                            <CheckBox x:Name="TailGlowCheck" Content="Enable trail glow"
                                      Checked="TailGlow_Toggle" Unchecked="TailGlow_Toggle"/>
                        </DockPanel>

                        <StackPanel x:Name="TailGlowPanel" IsEnabled="False">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetTailGlowColor" ToolTip="Reset to baseline"/>
                                        <TextBlock Text="Glow Color" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    </DockPanel>
                                    <ctrl:ColorPickerControl x:Name="TailGlowColorPicker" ColorChanged="TailGlowColor_Changed"/>
                                </StackPanel>

                                <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                    <DockPanel Margin="0,0,0,4">
                                        <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetTailGlowWidth" ToolTip="Reset to baseline"/>
                                        <TextBlock Text="Glow Width" Style="{StaticResource SectionHeader}" Margin="0"/>
                                    </DockPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="52"/>
                                        </Grid.ColumnDefinitions>
                                        <Slider x:Name="TailGlowWidthSlider" Minimum="2" Maximum="30"
                                                ValueChanged="TailGlowWidth_Changed" Grid.Column="0" VerticalAlignment="Center"/>
                                        <TextBox x:Name="TailGlowWidthBox" Style="{StaticResource ValueBox}" Grid.Column="1"
                                                 GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </StackPanel>

                        <!-- Trail Wave -->
                        <TextBlock Text="TRAIL WAVE" Style="{StaticResource SectionHeader}"/>
                        <Separator/>

                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetWaveEnabled" ToolTip="Reset to baseline"/>
                            <CheckBox x:Name="WaveCheck" Content="Enable wave effect"
                                      Checked="Wave_Toggle" Unchecked="Wave_Toggle"/>
                        </DockPanel>

                        <StackPanel x:Name="WavePanel" IsEnabled="False">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Amplitude (px)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="WaveAmpSlider" Minimum="1" Maximum="60" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="WaveAmp_Changed"/>
                                <TextBox x:Name="WaveAmpBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetWaveAmp" ToolTip="Reset to baseline"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Frequency" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="WaveFreqSlider" Minimum="0.5" Maximum="12" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="WaveFreq_Changed"/>
                                <TextBox x:Name="WaveFreqBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetWaveFreq" ToolTip="Reset to baseline"/>
                            </Grid>
                        </StackPanel>

                        <!-- Trail Pattern -->
                        <TextBlock Text="TRAIL PATTERN" Style="{StaticResource SectionHeader}"/>
                        <Separator/>
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                            <TextBlock Text="Style" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                            <ComboBox x:Name="TrailPatternCombo" Grid.Column="1" SelectionChanged="TrailPattern_Changed">
                                <ComboBoxItem Content="None"/>
                                <ComboBoxItem Content="Fire"/>
                                <ComboBoxItem Content="Electric"/>
                                <ComboBoxItem Content="Smoke"/>
                                <ComboBoxItem Content="Plasma"/>
                            </ComboBox>
                            <Button Content="&#x21BA;" Grid.Column="2" Style="{StaticResource ResetBtn}" Click="ResetTrailPattern" ToolTip="Reset to baseline"/>
                        </Grid>
                        <StackPanel x:Name="TrailPatternPanel" IsEnabled="False">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Speed" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="TrailPatternSpeedSlider" Minimum="0.1" Maximum="5" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="TrailPatternSpeed_Changed"/>
                                <TextBox x:Name="TrailPatternSpeedBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetTrailPatternSpeed" ToolTip="Reset to baseline"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Intensity" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="TrailPatternIntensitySlider" Minimum="0.1" Maximum="1" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="TrailPatternIntensity_Changed"/>
                                <TextBox x:Name="TrailPatternIntensityBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetTrailPatternIntensity" ToolTip="Reset to baseline"/>
                            </Grid>
                        </StackPanel>

                        <!-- Draw Mode -->
                        <TextBlock Text="DRAW MODE" Style="{StaticResource SectionHeader}" Margin="0,12,0,0"/>
                        <Separator/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetDrawModeEnabled" ToolTip="Reset to baseline"/>
                            <CheckBox x:Name="DrawModeCheck" Content="Enable draw mode (hold key to draw, double-tap to clear)"
                                      Checked="DrawMode_Toggle" Unchecked="DrawMode_Toggle"/>
                        </DockPanel>
                        <StackPanel x:Name="DrawModePanel" IsEnabled="False">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Hold key" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <ComboBox x:Name="DrawModeKeyCombo" Grid.Column="1" SelectionChanged="DrawModeKey_Changed">
                                    <ComboBoxItem Content="Left Ctrl"/>
                                    <ComboBoxItem Content="Right Ctrl"/>
                                    <ComboBoxItem Content="Left Alt"/>
                                    <ComboBoxItem Content="Right Alt"/>
                                    <ComboBoxItem Content="Left Shift"/>
                                    <ComboBoxItem Content="Right Shift"/>
                                    <ComboBoxItem Content="Caps Lock"/>
                                    <ComboBoxItem Content="Tab"/>
                                    <ComboBoxItem Content="F1"/>
                                    <ComboBoxItem Content="F2"/>
                                    <ComboBoxItem Content="F3"/>
                                    <ComboBoxItem Content="F4"/>
                                    <ComboBoxItem Content="F5"/>
                                    <ComboBoxItem Content="F6"/>
                                    <ComboBoxItem Content="F7"/>
                                    <ComboBoxItem Content="F8"/>
                                    <ComboBoxItem Content="F9"/>
                                    <ComboBoxItem Content="F10"/>
                                    <ComboBoxItem Content="F11"/>
                                    <ComboBoxItem Content="F12"/>
                                </ComboBox>
                                <Button Content="&#x21BA;" Grid.Column="2" Style="{StaticResource ResetBtn}" Click="ResetDrawModeKey" ToolTip="Reset to baseline"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Clear double-tap (ms)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="DrawModeClearMsSlider" Minimum="100" Maximum="800" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="DrawModeClearMs_Changed"/>
                                <TextBox x:Name="DrawModeClearMsBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetDrawModeClearMs" ToolTip="Reset to baseline"/>
                            </Grid>
                            <Button Content="Clear drawn lines" Margin="0,4,0,0" Padding="12,4"
                                    Click="ClearDrawnLines_Click" HorizontalAlignment="Left"/>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════ EFFECTS TAB ════════ -->
            <TabItem Header="Effects">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Background="#1E1E2E">
                    <StackPanel Margin="16,8,16,16">

                        <!-- Click Effects -->
                        <TextBlock Text="CLICK EFFECTS" Style="{StaticResource SectionHeader}"/>
                        <Separator/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetClickEffect" ToolTip="Reset to baseline"/>
                            <CheckBox x:Name="ClickEffectCheck" Content="Show effect on mouse click"
                                      Checked="ClickEffect_Toggle" Unchecked="ClickEffect_Toggle"/>
                        </DockPanel>
                        <StackPanel x:Name="ClickEffectPanel" IsEnabled="False">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="140"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Style" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <ComboBox x:Name="ClickEffectStyleCombo" Grid.Column="1"
                                          SelectionChanged="ClickEffectStyle_Changed">
                                    <ComboBoxItem Content="Ripple"/>
                                    <ComboBoxItem Content="Burst (dots)"/>
                                    <ComboBoxItem Content="Shockwave"/>
                                    <ComboBoxItem Content="Image Burst"/>
                                    <ComboBoxItem Content="Sparks"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="Color" Style="{StaticResource SectionHeader}" Margin="0,8,0,4"/>
                            <ctrl:ColorPickerControl x:Name="ClickEffectColorPicker" ColorChanged="ClickEffectColor_Changed"/>
                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Max Radius (px)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="ClickEffectSizeSlider" Minimum="10" Maximum="120" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="ClickEffectSize_Changed"/>
                                <TextBox x:Name="ClickEffectSizeBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetClickEffectSize" ToolTip="Reset to baseline"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Duration (ms)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="ClickEffectDurSlider" Minimum="100" Maximum="1500" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="ClickEffectDur_Changed"/>
                                <TextBox x:Name="ClickEffectDurBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetClickEffectDur" ToolTip="Reset to baseline"/>
                            </Grid>

                            <!-- Particle image (styles: Image Burst / Sparks) -->
                            <TextBlock Text="PARTICLE IMAGE (Image Burst / Sparks)" Style="{StaticResource SectionHeader}" Margin="0,10,0,4"/>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Clear" Margin="4,0,0,0" Click="ParticleImage_Clear"/>
                                <Button DockPanel.Dock="Right" Content="Browse…" Margin="4,0,0,0" Click="ParticleImage_Browse"/>
                                <TextBlock x:Name="ParticleImageLabel" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Text="None (use colored dots)"
                                           Foreground="#AAAAAA" FontStyle="Italic"/>
                            </DockPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Particle Count" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="SparkCountSlider" Minimum="1" Maximum="40" Grid.Column="1"
                                        VerticalAlignment="Center" IsSnapToTickEnabled="True" TickFrequency="1"
                                        ValueChanged="SparkCount_Changed"/>
                                <TextBox x:Name="SparkCountBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetSparkCount" ToolTip="Reset to baseline"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Particle Size (px)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="SparkParticleSizeSlider" Minimum="2" Maximum="48" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="SparkParticleSize_Changed"/>
                                <TextBox x:Name="SparkParticleSizeBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetSparkParticleSize" ToolTip="Reset to baseline"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Spread (deg)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="SparkSpreadSlider" Minimum="10" Maximum="360" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="SparkSpread_Changed"/>
                                <TextBox x:Name="SparkSpreadBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetSparkSpread" ToolTip="Reset to baseline"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Initial Speed" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="SparkSpeedSlider" Minimum="20" Maximum="1000" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="SparkSpeed_Changed"/>
                                <TextBox x:Name="SparkSpeedBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetSparkSpeed" ToolTip="Reset to baseline"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Gravity (px/s²)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="SparkGravitySlider" Minimum="0" Maximum="2000" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="SparkGravity_Changed"/>
                                <TextBox x:Name="SparkGravityBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetSparkGravity" ToolTip="Reset to baseline"/>
                            </Grid>
                        </StackPanel>

                        <!-- Right-click Effect -->
                        <TextBlock Text="RIGHT-CLICK EFFECT" Style="{StaticResource SectionHeader}"/>
                        <Separator/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetRightClick" ToolTip="Reset to baseline"/>
                            <CheckBox x:Name="RightClickCheck" Content="Show effect on right-click"
                                      Checked="RightClick_Toggle" Unchecked="RightClick_Toggle"/>
                        </DockPanel>
                        <StackPanel x:Name="RightClickPanel" IsEnabled="False">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Style" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <ComboBox x:Name="RightClickStyleCombo" Grid.Column="1" SelectionChanged="RightClickStyle_Changed">
                                    <ComboBoxItem Content="Ripple"/>
                                    <ComboBoxItem Content="Burst (dots)"/>
                                    <ComboBoxItem Content="Shockwave"/>
                                    <ComboBoxItem Content="Image Burst"/>
                                    <ComboBoxItem Content="Sparks"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="Color" Style="{StaticResource SectionHeader}" Margin="0,8,0,4"/>
                            <ctrl:ColorPickerControl x:Name="RightClickColorPicker" ColorChanged="RightClickColor_Changed"/>
                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Max Radius (px)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="RightClickSizeSlider" Minimum="10" Maximum="120" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="RightClickSize_Changed"/>
                                <TextBox x:Name="RightClickSizeBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetRightClickSize" ToolTip="Reset to baseline"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Duration (ms)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="RightClickDurSlider" Minimum="100" Maximum="1500" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="RightClickDur_Changed"/>
                                <TextBox x:Name="RightClickDurBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetRightClickDur" ToolTip="Reset to baseline"/>
                            </Grid>
                        </StackPanel>

                        <!-- Middle-click Effect -->
                        <TextBlock Text="MIDDLE-CLICK EFFECT" Style="{StaticResource SectionHeader}"/>
                        <Separator/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetMiddleClick" ToolTip="Reset to baseline"/>
                            <CheckBox x:Name="MiddleClickCheck" Content="Show effect on middle-click"
                                      Checked="MiddleClick_Toggle" Unchecked="MiddleClick_Toggle"/>
                        </DockPanel>
                        <StackPanel x:Name="MiddleClickPanel" IsEnabled="False">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Style" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <ComboBox x:Name="MiddleClickStyleCombo" Grid.Column="1" SelectionChanged="MiddleClickStyle_Changed">
                                    <ComboBoxItem Content="Ripple"/>
                                    <ComboBoxItem Content="Burst (dots)"/>
                                    <ComboBoxItem Content="Shockwave"/>
                                    <ComboBoxItem Content="Image Burst"/>
                                    <ComboBoxItem Content="Sparks"/>
                                </ComboBox>
                            </Grid>
                            <TextBlock Text="Color" Style="{StaticResource SectionHeader}" Margin="0,8,0,4"/>
                            <ctrl:ColorPickerControl x:Name="MiddleClickColorPicker" ColorChanged="MiddleClickColor_Changed"/>
                            <Grid Margin="0,6,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Max Radius (px)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="MiddleClickSizeSlider" Minimum="10" Maximum="120" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="MiddleClickSize_Changed"/>
                                <TextBox x:Name="MiddleClickSizeBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetMiddleClickSize" ToolTip="Reset to baseline"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Duration (ms)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="MiddleClickDurSlider" Minimum="100" Maximum="1500" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="MiddleClickDur_Changed"/>
                                <TextBox x:Name="MiddleClickDurBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetMiddleClickDur" ToolTip="Reset to baseline"/>
                            </Grid>
                        </StackPanel>

                        <!-- Double-click Effect -->
                        <TextBlock Text="DOUBLE-CLICK EFFECT" Style="{StaticResource SectionHeader}"/>
                        <Separator/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetDoubleClick" ToolTip="Reset to baseline"/>
                            <CheckBox x:Name="DoubleClickCheck" Content="Enhanced effect on double-click (uses left-click style)"
                                      Checked="DoubleClick_Toggle" Unchecked="DoubleClick_Toggle"/>
                        </DockPanel>
                        <StackPanel x:Name="DoubleClickPanel" IsEnabled="False">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Size multiplier" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="DoubleClickMultSlider" Minimum="1.1" Maximum="4.0" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="DoubleClickMult_Changed"/>
                                <TextBox x:Name="DoubleClickMultBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetDoubleClickMult" ToolTip="Reset to baseline"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Detect window (ms)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="DoubleClickMsSlider" Minimum="100" Maximum="600" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="DoubleClickMs_Changed"/>
                                <TextBox x:Name="DoubleClickMsBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetDoubleClickMs" ToolTip="Reset to baseline"/>
                            </Grid>
                        </StackPanel>

                        <!-- Click Cursor Swap -->
                        <TextBlock Text="CLICK CURSOR SWAP" Style="{StaticResource SectionHeader}"/>
                        <Separator/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetClickSwap" ToolTip="Reset to baseline"/>
                            <CheckBox x:Name="ClickSwapCheck" Content="Swap cursor image on click"
                                      Checked="ClickSwap_Toggle" Unchecked="ClickSwap_Toggle"/>
                        </DockPanel>
                        <StackPanel x:Name="ClickSwapPanel" IsEnabled="False">
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Clear" Margin="4,0,0,0" Click="ClickSwapImage_Clear"/>
                                <Button DockPanel.Dock="Right" Content="Browse…" Margin="4,0,0,0" Click="ClickSwapImage_Browse"/>
                                <TextBlock x:Name="ClickSwapImageLabel" VerticalAlignment="Center"
                                           TextTrimming="CharacterEllipsis" Text="No file selected"
                                           Foreground="#AAAAAA" FontStyle="Italic"/>
                            </DockPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Duration (ms)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="ClickSwapDurSlider" Minimum="50" Maximum="2000" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="ClickSwapDur_Changed"/>
                                <TextBox x:Name="ClickSwapDurBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetClickSwapDur" ToolTip="Reset to baseline"/>
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Image size (px)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="ClickSwapSizeSlider" Minimum="8" Maximum="150" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="ClickSwapSize_Changed"/>
                                <TextBox x:Name="ClickSwapSizeBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetClickSwapSize" ToolTip="Reset to baseline"/>
                            </Grid>
                        </StackPanel>

                        <!-- Auto-hide -->
                        <TextBlock Text="AUTO-HIDE" Style="{StaticResource SectionHeader}"/>
                        <Separator/>
                        <DockPanel Margin="0,0,0,10">
                            <Button DockPanel.Dock="Right" Content="&#x21BA;" Style="{StaticResource ResetBtn}" Click="ResetAutoHide" ToolTip="Reset to baseline"/>
                            <CheckBox x:Name="AutoHideCheck" Content="Hide laser when mouse is idle"
                                      Checked="AutoHide_Toggle" Unchecked="AutoHide_Toggle"/>
                        </DockPanel>
                        <StackPanel x:Name="AutoHidePanel" IsEnabled="False">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="140"/><ColumnDefinition Width="*"/><ColumnDefinition Width="52"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                <TextBlock Text="Idle delay (ms)" Style="{StaticResource RowLabel}" Grid.Column="0"/>
                                <Slider x:Name="AutoHideDelaySlider" Minimum="500" Maximum="30000" Grid.Column="1"
                                        VerticalAlignment="Center" ValueChanged="AutoHideDelay_Changed"/>
                                <TextBox x:Name="AutoHideDelayBox" Style="{StaticResource ValueBox}" Grid.Column="2"
                                         GotFocus="ValueBox_GotFocus" LostFocus="ValueBox_LostFocus" KeyDown="ValueBox_KeyDown"/>
                                <Button Content="&#x21BA;" Grid.Column="3" Style="{StaticResource ResetBtn}" Click="ResetAutoHideDelay" ToolTip="Reset to baseline"/>
                            </Grid>
                        </StackPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <!-- ════════ PROFILES TAB ════════ -->
            <TabItem Header="Profiles">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" Background="#1E1E2E">
                <Grid Margin="16,12" Background="#1E1E2E">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="220"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Profile list + buttons -->
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="SAVED PROFILES" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <ListBox x:Name="ProfileList" Height="280" SelectionChanged="ProfileList_Changed"/>

                        <WrapPanel Margin="0,8,0,0">
                            <Button Content="Apply"  Margin="0,0,4,4" Click="Profile_Apply"/>
                            <Button Content="Save Current" Margin="0,0,4,4" Click="Profile_SaveCurrent"/>
                            <Button Content="Delete" Margin="0,0,4,4" Click="Profile_Delete"/>
                        </WrapPanel>

                        <Separator Margin="0,12,0,8"/>
                        <TextBlock Text="BUILT-IN PRESETS" Style="{StaticResource SectionHeader}" Margin="0,0,0,6"/>
                        <ListBox x:Name="PresetList" Height="160" SelectionChanged="PresetList_Changed"/>
                        <Button Content="Apply Preset" Margin="0,8,0,0" HorizontalAlignment="Left" Click="Preset_Apply"/>
                    </StackPanel>

                    <!-- Profile details / rename -->
                    <StackPanel Grid.Column="1" Margin="20,0,0,0">
                        <TextBlock Text="PROFILE NAME" Style="{StaticResource SectionHeader}" Margin="0,0,0,4"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="ProfileNameBox" Padding="6,4" FontSize="13" Grid.Column="0"/>
                            <Button Content="Rename" Margin="6,0,0,0" Grid.Column="1" Click="Profile_Rename"/>
                        </Grid>

                        <Separator Margin="0,14,0,8"/>
                        <TextBlock Text="IMPORT / EXPORT" Style="{StaticResource SectionHeader}" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Export Profile…" Margin="0,0,8,0" Click="Profile_Export"/>
                            <Button Content="Import Profile…" Click="Profile_Import"/>
                        </StackPanel>
                    </StackPanel>

                </Grid>
                </ScrollViewer>
            </TabItem>

        </TabControl>

        <!-- ── Live Preview ── -->
        <Border Grid.Row="1" Margin="8,6,8,0" Background="#111122"
                BorderBrush="#2E2E44" BorderThickness="1" CornerRadius="4" Height="54">
            <Grid>
                <TextBlock Text="LIVE PREVIEW" Foreground="#333355" FontSize="9" FontWeight="SemiBold"
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0"/>
                <Canvas x:Name="PreviewCanvas" Margin="60,4,4,4" ClipToBounds="True"/>
            </Grid>
        </Border>

        <!-- ── Buttons ── -->
        <Border Grid.Row="2" Background="#141420" Padding="8,8">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Reset to Defaults" Margin="0,0,8,0" Click="Reset_Click"/>
                <Button Content="Close" Padding="18,4" Click="Close_Click"
                        Background="#FF3838" Foreground="White" BorderBrush="#CC2222"/>
            </StackPanel>
        </Border>
    </Grid>
</Window>
