<UserControl x:Class="LaserCursorAppPro.Controls.ColorPickerControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Width="224">
    <StackPanel Margin="4,4,4,0">

        <!-- S/V Canvas -->
        <Canvas x:Name="SvCanvas" Width="216" Height="140" Cursor="Crosshair"
                MouseLeftButtonDown="SvCanvas_MouseDown"
                MouseMove="SvCanvas_MouseMove"
                MouseLeftButtonUp="SvCanvas_MouseUp">
            <Rectangle Width="216" Height="140">
                <Rectangle.Fill><SolidColorBrush x:Name="HueBaseBrush" Color="#FF0000"/></Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="216" Height="140">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="White"       Offset="0"/>
                        <GradientStop Color="Transparent" Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle Width="216" Height="140">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="Transparent" Offset="0"/>
                        <GradientStop Color="Black"       Offset="1"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Ellipse x:Name="SvCursor" Width="12" Height="12"
                     Stroke="White" StrokeThickness="2"
                     Canvas.Left="0" Canvas.Top="0"
                     IsHitTestVisible="False"/>
        </Canvas>

        <!-- Hue bar -->
        <Canvas x:Name="HueCanvas" Width="216" Height="14" Margin="0,5,0,0" Cursor="Hand"
                MouseLeftButtonDown="HueCanvas_MouseDown"
                MouseMove="HueCanvas_MouseMove"
                MouseLeftButtonUp="HueCanvas_MouseUp">
            <Rectangle Width="216" Height="14" RadiusX="3" RadiusY="3">
                <Rectangle.Fill>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                        <GradientStop Color="#FF0000" Offset="0.000"/>
                        <GradientStop Color="#FFFF00" Offset="0.167"/>
                        <GradientStop Color="#00FF00" Offset="0.333"/>
                        <GradientStop Color="#00FFFF" Offset="0.500"/>
                        <GradientStop Color="#0000FF" Offset="0.667"/>
                        <GradientStop Color="#FF00FF" Offset="0.833"/>
                        <GradientStop Color="#FF0000" Offset="1.000"/>
                    </LinearGradientBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="HueCursor" Width="4" Height="16" Canvas.Top="-1" Canvas.Left="0"
                       Fill="White" Stroke="#666" StrokeThickness="1" RadiusX="2" RadiusY="2"
                       IsHitTestVisible="False"/>
        </Canvas>

        <!-- Alpha bar -->
        <Canvas x:Name="AlphaCanvas" Width="216" Height="14" Margin="0,4,0,0" Cursor="Hand"
                MouseLeftButtonDown="AlphaCanvas_MouseDown"
                MouseMove="AlphaCanvas_MouseMove"
                MouseLeftButtonUp="AlphaCanvas_MouseUp">
            <Rectangle Width="216" Height="14" RadiusX="3" RadiusY="3">
                <Rectangle.Fill>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,7,7" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#BBBBBB">
                                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,7,7"/></GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#888888">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,3.5,3.5"/>
                                            <RectangleGeometry Rect="3.5,3.5,3.5,3.5"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Rectangle.Fill>
            </Rectangle>
            <Rectangle x:Name="AlphaGradRect" Width="216" Height="14" RadiusX="3" RadiusY="3"/>
            <Rectangle x:Name="AlphaCursor" Width="4" Height="16" Canvas.Top="-1" Canvas.Left="0"
                       Fill="White" Stroke="#666" StrokeThickness="1" RadiusX="2" RadiusY="2"
                       IsHitTestVisible="False"/>
        </Canvas>

        <!-- Preview + Hex -->
        <Grid Margin="0,8,0,4">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="36"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Width="30" Height="30" BorderBrush="#999" BorderThickness="1" CornerRadius="4">
                <Border.Background>
                    <DrawingBrush TileMode="Tile" Viewport="0,0,6,6" ViewportUnits="Absolute">
                        <DrawingBrush.Drawing>
                            <DrawingGroup>
                                <GeometryDrawing Brush="#BBBBBB">
                                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,6,6"/></GeometryDrawing.Geometry>
                                </GeometryDrawing>
                                <GeometryDrawing Brush="#888888">
                                    <GeometryDrawing.Geometry>
                                        <GeometryGroup>
                                            <RectangleGeometry Rect="0,0,3,3"/>
                                            <RectangleGeometry Rect="3,3,3,3"/>
                                        </GeometryGroup>
                                    </GeometryDrawing.Geometry>
                                </GeometryDrawing>
                            </DrawingGroup>
                        </DrawingBrush.Drawing>
                    </DrawingBrush>
                </Border.Background>
                <Rectangle x:Name="PreviewSwatch" Width="30" Height="30" RadiusX="4" RadiusY="4"/>
            </Border>

            <StackPanel Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                <TextBlock Text="HEX (#AARRGGBB)" Foreground="#777" FontSize="9" Margin="0,0,0,2"/>
                <TextBox x:Name="HexBox" FontFamily="Consolas" FontSize="11"
                         Padding="4,2" MaxLength="9"
                         TextChanged="HexBox_TextChanged"/>
            </StackPanel>
        </Grid>

    </StackPanel>
</UserControl>
